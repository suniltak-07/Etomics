# App BFF origin for browser/SSR calls to `/api/*`.
# Leave empty to use the current host (local → http://localhost:3000, Vercel → that deploy).
# Set explicitly when pointing a local UI at a remote Next app, or when switching envs.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=https://your-dev-app.vercel.app

# Upstream OFOOD backend (server-only; Next route handlers proxy to this)
# Dev and prod currently share this ALB; swap prod later when a distinct URL exists.
OFOOD_API_BASE_URL=http://ofood-alb-604405684.ap-south-1.elb.amazonaws.com
